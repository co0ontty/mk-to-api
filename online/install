#!/usr/bin/env bash
set -euo pipefail

REPO="${MONKEYCODE_REPO:-co0ontty/mk-to-api}"
VERSION="${MONKEYCODE_VERSION:-latest}"
INSTALL_ROOT="${MONKEYCODE_INSTALL_ROOT:-$HOME/.local/lib/monkeycode-gateway}"
BIN_DIR="${MONKEYCODE_BIN_DIR:-$HOME/.local/bin}"

case "$(uname -s)" in
  Darwin) ;;
  *) echo "MonkeyCode Direct Gateway currently supports macOS only." >&2; exit 1 ;;
esac

case "$(uname -m)" in
  arm64|aarch64) ARCH="aarch64" ;;
  x86_64|amd64) ARCH="x86_64" ;;
  *) echo "Unsupported macOS architecture: $(uname -m)" >&2; exit 1 ;;
esac

ASSET="monkeycode-direct-gateway-macos-${ARCH}.tar.gz"
if [ "$VERSION" = "latest" ]; then
  URL="https://github.com/${REPO}/releases/latest/download/${ASSET}"
else
  case "$VERSION" in v*) TAG="$VERSION" ;; *) TAG="v$VERSION" ;; esac
  URL="https://github.com/${REPO}/releases/download/${TAG}/${ASSET}"
fi

TMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/monkeycode-install.XXXXXX")"
cleanup() { rm -rf "$TMP_DIR"; }
trap cleanup EXIT

printf 'Downloading %s...\n' "$URL"
curl --fail --location --silent --show-error "$URL?download=1" -o "$TMP_DIR/$ASSET"
mkdir -p "$INSTALL_ROOT" "$BIN_DIR"
tar -xzf "$TMP_DIR/$ASSET" -C "$TMP_DIR"

if [ ! -x "$TMP_DIR/monkeycode-direct-gateway" ]; then
  echo "Release archive does not contain monkeycode-direct-gateway" >&2
  exit 1
fi
if [ ! -f "$TMP_DIR/VERSION" ]; then
  printf '%s\n' "$VERSION" > "$TMP_DIR/VERSION"
fi

install -m 755 "$TMP_DIR/monkeycode-direct-gateway" "$INSTALL_ROOT/monkeycode-direct-gateway"
install -m 755 "$TMP_DIR/start-direct-gateway.sh" "$INSTALL_ROOT/start-direct-gateway.sh"
install -m 644 "$TMP_DIR/VERSION" "$INSTALL_ROOT/VERSION"

INSTALLER_URL="https://raw.githubusercontent.com/${REPO}/main/online/install?download=1"
cat > "$BIN_DIR/monkeycode-gateway" <<EOF
#!/usr/bin/env bash
set -euo pipefail
INSTALL_ROOT="$INSTALL_ROOT"
BIN_DIR="$BIN_DIR"
VERSION_FILE="\$INSTALL_ROOT/VERSION"
INSTALLER_URL="$INSTALLER_URL"

case "\${1:-start}" in
  update)
    echo "Updating MonkeyCode Direct Gateway from GitHub Release..."
    exec env MONKEYCODE_VERSION=latest MONKEYCODE_GATEWAY_START=1 MONKEYCODE_INSTALL_ROOT="\$INSTALL_ROOT" MONKEYCODE_BIN_DIR="\$BIN_DIR" bash -c "\$(curl --fail --location --silent --show-error \"\$INSTALLER_URL\")"
    ;;
  version)
    if [ -f "\$VERSION_FILE" ]; then cat "\$VERSION_FILE"; else echo "unknown"; fi
    ;;
  check-update)
    current="\$(if [ -f \"\$VERSION_FILE\" ]; then cat \"\$VERSION_FILE\"; else echo unknown; fi)"
    latest="\$(curl --fail --location --silent --show-error "https://api.github.com/repos/${REPO}/releases/latest" | python3 -c 'import json,sys; print(json.load(sys.stdin)["tag_name"])')"
    echo "installed: \$current"
    echo "latest:    \$latest"
    if [ "\$current" = "\$latest" ]; then echo "already up to date"; else echo "update available: run monkeycode-gateway update"; fi
    ;;
  *)
    exec env DIRECT_GATEWAY_BIN="\$INSTALL_ROOT/monkeycode-direct-gateway" "\$INSTALL_ROOT/start-direct-gateway.sh" "\$@"
    ;;
esac
EOF
chmod 755 "$BIN_DIR/monkeycode-gateway"

printf '\nInstalled MonkeyCode Direct Gateway to %s\n' "$INSTALL_ROOT"
printf 'Command: %s/monkeycode-gateway\n' "$BIN_DIR"
printf 'Admin UI: http://0.0.0.0:8123/admin\n'

if [ "${MONKEYCODE_GATEWAY_START:-1}" = "1" ]; then
  "$BIN_DIR/monkeycode-gateway" start
else
  printf 'Automatic start disabled. Run: %s/monkeycode-gateway start\n' "$BIN_DIR"
fi
