#!/usr/bin/env bash
set -euo pipefail

REPO="${MONKEYCODE_REPO:-co0ontty/mk-to-api}"
VERSION="${MONKEYCODE_VERSION:-latest}"
INSTALL_ROOT="${MONKEYCODE_INSTALL_ROOT:-$HOME/.local/lib/mk2api}"
BIN_DIR="${MONKEYCODE_BIN_DIR:-$HOME/.local/bin}"

case "$(uname -s)" in
  Darwin) ;;
  *) echo "mk2api currently supports macOS only." >&2; exit 1 ;;
esac

case "$(uname -m)" in
  arm64|aarch64) ARCH="aarch64" ;;
  x86_64|amd64) ARCH="x86_64" ;;
  *) echo "Unsupported macOS architecture: $(uname -m)" >&2; exit 1 ;;
esac

ASSET="mk2api-macos-${ARCH}.tar.gz"
LEGACY_ASSET="monkeycode-direct-gateway-macos-${ARCH}.tar.gz"
if [ "$VERSION" = "latest" ]; then
  URL="https://github.com/${REPO}/releases/latest/download/${ASSET}"
  LEGACY_URL="https://github.com/${REPO}/releases/latest/download/${LEGACY_ASSET}"
else
  case "$VERSION" in v*) TAG="$VERSION" ;; *) TAG="v$VERSION" ;; esac
  URL="https://github.com/${REPO}/releases/download/${TAG}/${ASSET}"
  LEGACY_URL="https://github.com/${REPO}/releases/download/${TAG}/${LEGACY_ASSET}"
fi

TMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/mk2api-install.XXXXXX")"
cleanup() { rm -rf "$TMP_DIR"; }
trap cleanup EXIT

printf 'Downloading %s...\n' "$URL"
if ! curl --fail --location --silent --show-error "$URL?download=1" -o "$TMP_DIR/$ASSET"; then
  printf 'Falling back to %s...\n' "$LEGACY_URL"
  curl --fail --location --silent --show-error "$LEGACY_URL?download=1" -o "$TMP_DIR/$ASSET"
fi
mkdir -p "$INSTALL_ROOT" "$BIN_DIR"
tar -xzf "$TMP_DIR/$ASSET" -C "$TMP_DIR"

BIN=""
for candidate in mk2api monkeycode-direct-gateway; do
  if [ -x "$TMP_DIR/$candidate" ]; then
    BIN="$candidate"
    break
  fi
done
if [ -z "$BIN" ]; then
  echo "Release archive does not contain mk2api" >&2
  exit 1
fi
if [ ! -f "$TMP_DIR/VERSION" ]; then
  printf '%s\n' "$VERSION" > "$TMP_DIR/VERSION"
fi

install -m 755 "$TMP_DIR/$BIN" "$INSTALL_ROOT/mk2api"
install -m 644 "$TMP_DIR/VERSION" "$INSTALL_ROOT/VERSION"
ln -sfn "$INSTALL_ROOT/mk2api" "$BIN_DIR/mk2api"
if [ -x "$INSTALL_ROOT/mk2api" ]; then
  ln -sfn "$INSTALL_ROOT/mk2api" "$BIN_DIR/monkeycode-gateway" || true
fi

printf '\nInstalled mk2api to %s\n' "$INSTALL_ROOT"
printf 'Command: %s/mk2api\n' "$BIN_DIR"
printf 'Config: %s/.mk2api\n' "$HOME"

if [ "${MONKEYCODE_GATEWAY_START:-1}" = "1" ]; then
  MK2API_NONINTERACTIVE=1 "$BIN_DIR/mk2api" start
else
  printf 'Automatic start disabled. Run: %s/mk2api start\n' "$BIN_DIR"
fi
